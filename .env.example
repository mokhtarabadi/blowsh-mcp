# blowsh-mcp Example Environment Variables

# Transport type for MCP server: 'stdio', 'http' (or 'streamable-http'), 'sse'
MCP_TRANSPORT=stdio

# Singleton transport binding (only used when MCP_TRANSPORT is http or sse).
# Defaults: 127.0.0.1:8107 for streamable HTTP, 127.0.0.1:8108 for legacy SSE.
# Inside Docker bind MCP_HOST=0.0.0.0 and lock the host side to loopback
# (-p 127.0.0.1:8107:8107) so the port never leaves this machine.
MCP_HOST=127.0.0.1
MCP_PORT=8107

# Path to Firefox executable for Browsh (--firefox.path); default is "firefox"
BROWSH_FIREFOX_PATH=firefox

# Path to html2markdown binary (optional, default: html2markdown in PATH)
HTML2MARKDOWN_PATH=html2markdown
NODE_ENV=production

# SSRF guard: when true, requests to loopback/private/link-local/reserved
# addresses are refused (default false = guard enabled)
ALLOW_PRIVATE_URLS=false

# Max PDF file size accepted by `fetch_web type: pdf`, in bytes (default 20 MB)
PDF_MAX_BYTES=20971520

# In-memory render cache TTL in milliseconds (default 300000 = 5 min)
CACHE_TTL_MS=300000

# Per-request timeout for Browsh renders in milliseconds (default 180000).
# A render's wait behind the request mutex is bounded separately by
# BROWSH_QUEUE_TIMEOUT_MS, so raising this cannot make a call hang.
BROWSH_REQUEST_TIMEOUT_MS=180000

# Queue-wait budget in ms before a render fails instead of waiting forever
# (default 600000 = 10 min). The per-render timeout only starts once the mutex
# is granted, so without this bound a queued render could hang silently.
# Keep this >= 2x BROWSH_REQUEST_TIMEOUT_MS and <= SEARCH_DEADLINE_MS.
BROWSH_QUEUE_TIMEOUT_MS=600000

# Default wall-clock budget for one search_web call when the caller omits
# deadline_ms (default 900000 = 15 min). On expiry the in-flight renders are
# aborted and the call ends in an honest deadline.hit error, never a silent
# hang. Keep this >= BROWSH_QUEUE_TIMEOUT_MS + BROWSH_REQUEST_TIMEOUT_MS.
SEARCH_DEADLINE_MS=900000

# How long a search engine that answered with a bot-block page is remembered
# and skipped, in ms (default 600000 = 10 min). Prevents a dead tier from
# costing a serialized render on every parallel search.
SEARCH_BLOCKED_ENGINE_TTL_MS=600000

# Cold-start budget for the Browsh HTTP endpoint in milliseconds (default 120000).
# Measured cold start is ~31s on a warm profile, so a 30s window failed every
# first fetch after a container start; raise this on slow hosts.
BROWSH_STARTUP_TIMEOUT_MS=120000

# Per-probe timeout for the Browsh control-channel health check in milliseconds
# (default 5000, clamped 1000-60000). Browsh renders its welcome page on every
# probe, which takes ~1s on a busy host; the old hardcoded 800ms made startup
# fail even though the endpoint was answering HTTP 200. Raise on very slow hosts.
BROWSH_HEALTH_PROBE_TIMEOUT_MS=5000

# Browser session health
# ----------------------
# Number of requests after which the Browsh process is recycled (default 100)
BROWSH_RECYCLE_REQUESTS=100

# Idle time in ms before the browser process is killed (default 600000 = 10 min)
BROWSH_IDLE_TIMEOUT_MS=600000

# Crash storm containment
# -----------------------
# Browsh 1.8.0 can die from a Go interfacer panic when Firefox starts/quits
# during a race. Three unexpected child exits inside the window open a circuit
# that rejects new renders until the cooldown expires, stopping a respawn loop
# from pinning the CPU and burying callers in the single render queue.
# Intentional recycle/idle/shutdown teardown never counts as a crash.
BROWSH_CRASH_WINDOW_MS=60000
BROWSH_CRASH_THRESHOLD=3
BROWSH_CRASH_COOLDOWN_MS=30000

# Browser persistence & viewport (task 08 hardening)
# -------------------------------------------------
# Browsh 1.8.0 has no profile-dir flag: the server redirects the Browsh
# child's HOME here, so cookies/history/storage persist across restarts
# when backed by a named volume or bind-mount (default /data/browsh-profile)
BROWSH_PROFILE_DIR=/data/browsh-profile

# Terminal dims passed to the Browsh child (defaults 160x60)
BROWSH_COLS=160
BROWSH_ROWS=60

# Boot prewarm: bring the browser up at server start (default on, 0 disables)
BROWSH_PREWARM=1

# Guard detection kill-switch: 0 disables bot-wall detection + trailer
# (JSON log line per fetch stays). Per-host verdict cache TTL ms (default 1h)
GUARD_DETECT=1
GUARD_CACHE_TTL_MS=3600000

# Total wall-clock budget in ms for the search_web enrich phase (default 180000).
# Each enrichment is a full page render, so this must fund at least one
# BROWSH_REQUEST_TIMEOUT_MS render; it is also clamped to the search budget.
ENRICH_BUDGET_MS=180000

# Upstream proxy (Docker-friendly)
# -------------------------------
# All six knobs are read from .env at startup. PROXY_TYPE=none is the default
# and writes a deterministic direct-mode Firefox preference, so a stale
# user.js on a persistent /data/browsh-profile volume cannot keep a proxy on.
# PROXY_TYPE: none | http | socks5. Any other value aborts startup.
PROXY_TYPE=none
# Hostname or IP only: no scheme, path, port, or credentials. Required when
# PROXY_TYPE is http or socks5. For a proxy on the Docker host use
# host.docker.internal on Desktop, or --add-host=host.docker.internal:host-gateway
# on Linux, or run the container with --network host and use 127.0.0.1.
PROXY_HOST=
# Proxy port, integer 1..65535. Required when PROXY_TYPE is http or socks5.
PROXY_PORT=
# Optional credentials. PROXY_PASSWORD without PROXY_USERNAME aborts startup.
# Values are never logged; they are URL-encoded for axios and JSON-escaped for
# the Firefox profile.
PROXY_USERNAME=
PROXY_PASSWORD=
# Comma-separated bypass list. localhost and 127.0.0.1 are ALWAYS added even
# when omitted, because the Browsh control channel lives on 127.0.0.1:4333.
PROXY_BYPASS=localhost,127.0.0.1

# (Add custom MCP/AI integration secrets below as needed)
