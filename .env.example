# blowsh-mcp Example Environment Variables

# Transport type for MCP server (e.g. 'stdio', 'streamable-http')
MCP_TRANSPORT=stdio

# Path to Firefox executable for Browsh (--firefox.path); default is "firefox"
BROWSH_FIREFOX_PATH=firefox

# Path to html2markdown binary (optional, default: html2markdown in PATH)
HTML2MARKDOWN_PATH=html2markdown
NODE_ENV=production

# SSRF guard: when true, requests to loopback/private/link-local/reserved
# addresses are refused (default false = guard enabled)
ALLOW_PRIVATE_URLS=false

# Max PDF file size accepted by `fetch_web type: pdf`, in bytes (default 20 MB)
PDF_MAX_BYTES=20971520

# In-memory render cache TTL in milliseconds (default 300000 = 5 min)
CACHE_TTL_MS=300000

# Per-request timeout for Browsh renders in milliseconds (default 30000)
BROWSH_REQUEST_TIMEOUT_MS=30000

# Browser session health
# ----------------------
# Number of requests after which the Browsh process is recycled (default 100)
BROWSH_RECYCLE_REQUESTS=100

# Idle time in ms before the browser process is killed (default 600000 = 10 min)
BROWSH_IDLE_TIMEOUT_MS=600000

# Browser persistence & viewport (task 08 hardening)
# -------------------------------------------------
# Browsh 1.8.0 has no profile-dir flag: the server redirects the Browsh
# child's HOME here, so cookies/history/storage persist across restarts
# when backed by a named volume or bind-mount (default /data/browsh-profile)
BROWSH_PROFILE_DIR=/data/browsh-profile

# Terminal dims passed to the Browsh child (defaults 160x60)
BROWSH_COLS=160
BROWSH_ROWS=60

# Boot prewarm: bring the browser up at server start (default on, 0 disables)
BROWSH_PREWARM=1

# Guard detection kill-switch: 0 disables bot-wall detection + trailer
# (JSON log line per fetch stays). Per-host verdict cache TTL ms (default 1h)
GUARD_DETECT=1
GUARD_CACHE_TTL_MS=3600000

# (Add custom MCP/AI integration secrets below as needed)
