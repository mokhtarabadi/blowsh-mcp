{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "cognitive-executor",
  "instructions": [
    "AGENTS.md",
    "docs/architecture.md",
    "docs/data_model.md",
    "docs/conventions.md"
  ],
  "formatter": false,
  "lsp": {
    "typescript": {
      "command": [
        "typescript-language-server",
        "--stdio"
      ]
    }
  },
  "permission": {
    "blowsh_*": "allow",
    "bash": {
      "git add": "deny",
      "git add *": "deny",
      "git checkout": "deny",
      "git checkout *": "deny",
      "git commit": "deny",
      "git commit *": "deny",
      "git push": "deny",
      "git push *": "deny"
    }
  }
}
